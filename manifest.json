{
  "manifest_version": 3,
  "name": "Aviator Live Analyzer",
  "version": "0.3.0",
  "description": "Read-only statistical monitor for visible Aviator round history.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_title": "Aviator Analyzer", "default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true},
    {"matches": ["<all_urls>"], "js": ["page-hook.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}
  ]
}
